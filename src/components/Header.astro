---
import { ChevronRight, Menu } from '@mynaui/icons-react';
---

<header class="flex items-center justify-between mb-12 relative">
  <div class="flex items-center gap-3">
    <a href="" class="hover:animate-rotational-wave"
      ><img src="/images/HeadGuimar.svg" class="w-auto h-9" alt="LogoCabeza" /></a
    >
    <label class="text-[#061B6E] text-[28px] font-extrabold font-sagace"
      ><span>Guimar</span>Bot</label
    >
  </div>

  <ul class="hidden lg:flex gap-12 text-[#061B6E] font-onest font-medium text-lg">
    <li><a href="#about" class="hover:text-[#E770E6] transition-all duration-300">Nosotros</a></li>
    <li><a href="#courses" class="hover:text-[#E770E6] transition-all duration-300">Cursos</a></li>
    <li>
      <a href="#contact" class="hover:text-[#E770E6] transition-all duration-300">Contacto</a>
    </li>
  </ul>

  <a
    href="#contact"
    class="hidden lg:flex items-center gap-0.5 border-2 border-[#E770E6] rounded-full px-6 py-1.5 text-[#E770E6] font-onest font-semibold cursor-pointer hover:bg-[#E770E6] hover:text-[#061B6E] transition-all duration-300"
  >
    Inscribirme ahora
    <ChevronRight className="w-4 h-4 text-[#E770E6]" strokeWidth={2} />
  </a>

  <button
    id="menu-toggle"
    class="lg:hidden flex items-center justify-center w-10 h-10 text-[#061B6E] hover:text-[#E770E6] transition-all duration-300"
    aria-label="Abrir menú"
  >
    <Menu className="w-6 h-6" strokeWidth={2} />
  </button>

  <div
    id="sidebar-overlay"
    class="fixed inset-0 bg-transparent z-40 hidden transition-opacity duration-300 lg:hidden"
  >
  </div>

  <div
    id="mobile-menu"
    class="fixed top-0 right-0 h-full w-72 max-w-[90vw] bg-white z-50 transform translate-x-full transition-transform duration-300 ease-in-out rounded-l-2xl shadow-2xl flex flex-col lg:hidden"
  >
    <div class="flex items-center justify-between p-6 border-b border-gray-200">
      <button
        id="close-menu"
        class="flex items-center justify-center w-10 h-10 text-[#061B6E] hover:text-[#E770E6] transition-all duration-300"
        aria-label="Cerrar menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="flex-1 flex flex-col justify-start py-16 items-center">
      <ul class="flex flex-col gap-8 text-center">
        <li>
          <a
            href="#about"
            class="text-[#061B6E] font-onest font-medium text-xl hover:text-[#E770E6] transition-all duration-300"
            >Nosotros</a
          >
        </li>
        <li>
          <a
            href="#courses"
            class="text-[#061B6E] font-onest font-medium text-xl hover:text-[#E770E6] transition-all duration-300"
            >Cursos</a
          >
        </li>
        <li>
          <a
            href="#contact"
            class="text-[#061B6E] font-onest font-medium text-xl hover:text-[#E770E6] transition-all duration-300"
            >Contacto</a
          >
        </li>
      </ul>
    </nav>

    <div class="p-6 border-t border-gray-200">
      <button
        class="w-full flex items-center justify-center gap-0.5 border-2 border-[#E770E6] rounded-full px-6 py-3 text-[#E770E6] font-onest font-semibold cursor-pointer hover:bg-[#E770E6] hover:text-[#061B6E] transition-all duration-300"
      >
        Inscribirme ahora
        <ChevronRight className="w-4 h-4 text-[#E770E6]" strokeWidth={2} />
      </button>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const closeMenu = document.getElementById('close-menu');
  const mobileMenu = document.getElementById('mobile-menu');
  const sidebarOverlay = document.getElementById('sidebar-overlay');

  function openMenu() {
    if (mobileMenu && sidebarOverlay) {
      mobileMenu.classList.remove('translate-x-full');
      sidebarOverlay.classList.remove('hidden');
      sidebarOverlay.classList.add('block');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMenuFunc() {
    if (mobileMenu && sidebarOverlay) {
      mobileMenu.classList.add('translate-x-full');
      sidebarOverlay.classList.remove('block');
      sidebarOverlay.classList.add('hidden');
      document.body.style.overflow = 'auto';
    }
  }

  menuToggle?.addEventListener('click', openMenu);
  closeMenu?.addEventListener('click', closeMenuFunc);
  sidebarOverlay?.addEventListener('click', closeMenuFunc);

  if (mobileMenu) {
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks?.forEach((link) => {
      link.addEventListener('click', closeMenuFunc);
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeMenuFunc();
    }
  });
</script>
