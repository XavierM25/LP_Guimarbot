<section class="flex flex-col justify-between items-center py-40">
  <div class="flex flex-col items-center mb-15">
    <h1 class="font-onest text-[#061B6E] items-center text-[52px] font-extrabold">
      CONTÁCTANOS 📞
    </h1>
    <p class="font-onest text-[#828CB6] text-xl font-medium">
      Solicitar más información sobre inscripción, modalidades y fechas.
    </p>
  </div>

  <div class="w-full flex gap-20 px-10">
    <div class="w-[50%]">
      <form id="contactForm" method="post">
        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Apellidos y Nombres</label>
          <input
            name="name"
            type="text"
            placeholder="Apellido y Nombres"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
            required
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Correo electrónico</label>
          <input
            name="email"
            type="email"
            placeholder="email@email.com"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
            required
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Teléfono</label>
          <input
            name="phone"
            type="tel"
            placeholder="+123456789"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
            required
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Curso a seleccionar</label>
          <select
            name="course"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
            required
          >
            <option value="">Selecciona el curso de interés</option>
            <option value="robotics">Robotics</option>
            <option value="coders">Coders</option>
            <option value="gamers">Gamers</option>
            <option value="traders">Traders</option>
          </select>
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold"
            >¿Cómo podemos ayudarte?</label
          >
          <textarea
            name="message"
            placeholder="Redacta tu mensaje"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
            required></textarea>
        </div>

        <img class="w-full" src="/reCAPTCHA.svg" />

        <button
          type="submit"
          id="submitBtn"
          class="w-full flex items-center gap-1 justify-center cursor-pointer font-onest font-bold bg-[#8436D8] text-[#D9E53D] rounded-xl px-3 py-2 mt-4 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="submitText">Enviar solicitud</span>
          <div
            id="loadingSpinner"
            class="hidden animate-spin rounded-full h-4 w-4 border-b-2 border-white"
          >
          </div>
        </button>
      </form>

      <!-- Mensaje de estado -->
      <div id="statusMessage" class="mt-4 p-3 rounded-xl hidden"></div>
    </div>

    <div class="flex w-[40%] justify-around items-center">
      <div class="flex flex-col justify-center items-center">
        <img class="w-40 h-40" src="/images/HeadGuimar.svg" />
        <label
          class="flex font-onest font-semibold italic text-center leading-tight text-[#061B6E] text-[20px]"
          >Únete a la comunidad GuímarBot y<br />construye el futuro desde hoy.</label
        >
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const submitText = document.getElementById('submitText') as HTMLSpanElement;
    const loadingSpinner = document.getElementById('loadingSpinner') as HTMLDivElement;
    const statusMessage = document.getElementById('statusMessage') as HTMLDivElement;

    if (form) {
      form.addEventListener('submit', async function (e) {
        e.preventDefault();

        // Deshabilitar el botón y mostrar spinner
        submitBtn.disabled = true;
        submitText.textContent = 'Enviando...';
        loadingSpinner.classList.remove('hidden');
        statusMessage.classList.add('hidden');

        // Obtener datos del formulario
        const formData = new FormData(form);
        const data = {
          name: formData.get('name') as string,
          email: formData.get('email') as string,
          phone: formData.get('phone') as string,
          course: formData.get('course') as string,
          message: formData.get('message') as string,
        };

        try {
          const response = await fetch(
            'https://backend-guimarbot-bwc8.onrender.com/api/v1/contact',
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(data),
            }
          );

          if (response.ok) {
            const result = await response.json();

            // Mostrar mensaje de éxito
            statusMessage.className =
              'mt-4 p-3 rounded-xl bg-green-100 border border-green-400 text-green-700';
            statusMessage.textContent = '¡Mensaje enviado exitosamente! Te contactaremos pronto.';
            statusMessage.classList.remove('hidden');

            // Limpiar formulario
            form.reset();
          } else {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Error al enviar el mensaje');
          }
        } catch (error) {
          console.error('Error:', error);

          // Mostrar mensaje de error
          statusMessage.className =
            'mt-4 p-3 rounded-xl bg-red-100 border border-red-400 text-red-700';
          statusMessage.textContent =
            error instanceof Error
              ? error.message
              : 'Error al enviar el mensaje. Por favor, inténtalo de nuevo.';
          statusMessage.classList.remove('hidden');
        } finally {
          // Rehabilitar el botón y ocultar spinner
          submitBtn.disabled = false;
          submitText.textContent = 'Enviar solicitud';
          loadingSpinner.classList.add('hidden');
        }
      });
    }
  });
</script>
