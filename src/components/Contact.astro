<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-3"></div>
<section id="contact" class="flex flex-col justify-between items-center py-16">
  <div class="flex flex-col items-center mb-15">
    <h1 class="font-onest text-[#061B6E] items-center text-[52px] font-extrabold">
      CONTÁCTANOS 📞
    </h1>
    <p class="font-onest text-[#828CB6] text-xl font-medium">
      Solicitar más información sobre inscripción, modalidades y fechas.
    </p>
  </div>

  <div class="w-full flex gap-20 px-10 justify-center">
    <div class="w-[45%]">
      <form id="contactForm" method="post">
        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Apellidos y Nombres</label>
          <input
            name="name"
            type="text"
            placeholder="Apellido y Nombres"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2] font-onest"
            required
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Correo electrónico</label>
          <input
            name="email"
            type="email"
            placeholder="email@email.com"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2] font-onest"
            required
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Teléfono</label>
          <input
            name="phone"
            type="tel"
            placeholder="123456789"
            pattern="[\+]?[0-9]{9,15}"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2] font-onest"
            required
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Curso a seleccionar</label>
          <select
            name="course"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2] font-onest"
            required
          >
            <option value="">Selecciona el curso de interés</option>
            <option value="robotics">Robotics</option>
            <option value="coders">Coders</option>
            <option value="gamers">Gamers</option>
            <option value="traders">Traders</option>
          </select>
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold"
            >¿Cómo podemos ayudarte?</label
          >
          <textarea
            name="message"
            minlength="10"
            maxlength="512"
            placeholder="Redacta tu mensaje (mínimo 10 caracteres)"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2] font-onest resize-none"
            required></textarea>
        </div>

        <button
          type="submit"
          id="submitBtn"
          class="w-full flex items-center gap-1 justify-center cursor-pointer font-onest font-bold hover:bg-[#D9E53D] hover:text-[#8436D8] transition-all duration-300 bg-[#8436D8] text-[#D9E53D] rounded-xl px-3 py-2 mt-4 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="submitText">Enviar solicitud</span>
          <div
            id="loadingSpinner"
            class="hidden animate-spin rounded-full h-4 w-4 border-b-2 border-white"
          >
          </div>
        </button>
      </form>

      <div id="statusMessage" class="mt-4 p-3 rounded-xl hidden"></div>
    </div>

    <div class="flex w-[40%] justify-around items-center">
      <div class="flex flex-col justify-center items-center">
        <img class="w-40 h-40" src="/images/HeadGuimar.svg" />
        <label
          class="flex font-onest font-semibold italic text-center leading-tight text-[#061B6E] text-[20px]"
          >Únete a la comunidad GuímarBot y<br />construye el futuro desde hoy.</label
        >
      </div>
    </div>
  </div>
</section>

<script>
  function mostrarToast(
    tipo: 'success' | 'warning' | 'error',
    titulo: string,
    descripcion: string
  ) {
    const toastContainer = document.getElementById('toast-container');
    if (!toastContainer) return;

    const iconos = {
      success: '✅',
      warning: '⚠️',
      error: '⛔',
    };

    const colores = {
      success: '6ef42f',
      warning: 'f4ee2f',
      error: 'f42f2f',
    };

    const toastHTML = `
      <figure class="toast-element shadow-lg relative mx-auto w-full max-w-[350px] min-h-fit p-4 cursor-pointer overflow-hidden rounded-2xl bg-white transition-all duration-200 ease-in-out hover:scale-[1.03] shadow-[0_0_0_1px_rgba(0,0,0,0.03),0_2px_4px_rgba(0,0,0,0.05),0_12px_24px_rgba(0,0,0,0.05)] transform-gpu dark:bg-transparent dark:backdrop-blur-md dark:border dark:border-[rgba(255,255,255,0.1)] dark:shadow-[inset_0_-20px_80px_-20px_#ffffff1f] animate-slide-in">
        <div class="flex flex-row items-center gap-3">
          <div class="flex size-10 items-center justify-center rounded-2xl">
            <span class="text-lg">${iconos[tipo]}</span>
          </div>
          <div class="flex flex-col overflow-hidden">
            <div class="flex w-full items-center text-lg font-medium text-black">
              <span class="text-sm sm:text-lg font-onest">${titulo}</span>
              <img
                src="https://raw.githubusercontent.com/XavierM25/ResourceImageGuimarBot/refs/heads/main/HeadGuimar.svg"
                class="h-5.5 w-auto px-4"
              />
            </div>
            <p class="text-sm text-black/60 font-onest font-light">${descripcion}</p>
          </div>
        </div>
      </figure>
    `;

    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = toastHTML;
    const toastElement = tempDiv.firstElementChild as HTMLElement;

    toastContainer.appendChild(toastElement);

    toastElement.addEventListener('click', () => {
      cerrarToast(toastElement);
    });

    setTimeout(() => {
      cerrarToast(toastElement);
    }, 5000);
  }

  function cerrarToast(toastElement: HTMLElement) {
    if (toastElement && toastElement.parentNode) {
      toastElement.style.opacity = '0';
      toastElement.style.transform = 'translateX(100%)';
      setTimeout(() => {
        if (toastElement.parentNode) {
          toastElement.parentNode.removeChild(toastElement);
        }
      }, 300);
    }
  }

  async function enviarFormularioContacto(datosFormulario: any) {
    const API_URL = '/api/contact';

    try {
      const response = await fetch(API_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(datosFormulario),
      });

      const resultado = await response.json();

      if (response.ok && resultado.success) {
        return {
          success: true,
          message: resultado.message,
          timestamp: resultado.timestamp,
        };
      } else {
        throw new Error(resultado.message || 'Error en la respuesta del servidor');
      }
    } catch (error: any) {
      return {
        success: false,
        message: error.message || 'Error de conexión',
        error: error,
      };
    }
  }

  function mostrarMensaje(mensaje: string, tipo: string = 'info') {
    const statusMessage = document.getElementById('statusMessage');
    if (statusMessage) {
      statusMessage.className = 'mt-4 p-3 rounded-xl transition-all duration-300';

      const clasesTipo = {
        success: 'bg-green-500 text-white border-l-4 border-green-700',
        error: 'bg-red-500 text-white border-l-4 border-red-700',
        warning: 'bg-yellow-500 text-white border-l-4 border-yellow-700',
        info: 'bg-blue-500 text-white border-l-4 border-blue-700',
      };

      statusMessage.className += ` ${clasesTipo[tipo as keyof typeof clasesTipo] || clasesTipo.info}`;
      statusMessage.textContent = mensaje;
      statusMessage.classList.remove('hidden');

      setTimeout(() => {
        if (statusMessage) {
          statusMessage.style.opacity = '0';
          setTimeout(() => {
            statusMessage.classList.add('hidden');
            statusMessage.style.opacity = '1';
          }, 300);
        }
      }, 5000);
    }
  }

  function validarFormulario(datosParaAPI: any): { esValido: boolean; mensaje?: string } {
    if (!datosParaAPI.fullName || datosParaAPI.fullName.trim().length < 2) {
      return { esValido: false, mensaje: 'El nombre debe tener al menos 2 caracteres' };
    }

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!datosParaAPI.email || !emailRegex.test(datosParaAPI.email)) {
      return { esValido: false, mensaje: 'Por favor ingresa un email válido' };
    }

    const phoneRegex = /^[\+]?[0-9]{9,15}$/;
    if (!datosParaAPI.phone || !phoneRegex.test(datosParaAPI.phone.replace(/\s/g, ''))) {
      return { esValido: false, mensaje: 'Por favor ingresa un teléfono válido (9-15 dígitos)' };
    }

    const cursosValidos = ['robotics', 'coders', 'gamers', 'traders'];
    if (!datosParaAPI.course || !cursosValidos.includes(datosParaAPI.course)) {
      return { esValido: false, mensaje: 'Por favor selecciona un curso válido' };
    }

    if (
      datosParaAPI.message &&
      datosParaAPI.message.trim().length > 0 &&
      datosParaAPI.message.trim().length < 10
    ) {
      return { esValido: false, mensaje: 'El mensaje debe tener al menos 10 caracteres' };
    }

    return { esValido: true };
  }

  async function manejarEnvioFormulario(event: Event) {
    event.preventDefault();

    const form = event.target as HTMLFormElement;
    const formData = new FormData(form);

    const datosParaAPI = {
      fullName: (formData.get('name') as string)?.trim(),
      email: (formData.get('email') as string)?.trim().toLowerCase(),
      phone: (formData.get('phone') as string)?.trim(),
      course: formData.get('course') as string,
      message: (formData.get('message') as string)?.trim() || '',
    };

    const validacion = validarFormulario(datosParaAPI);
    if (!validacion.esValido) {
      mostrarToast('error', '¡Error de validación!', validacion.mensaje!);
      return;
    }

    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const submitText = document.getElementById('submitText');
    const loadingSpinner = document.getElementById('loadingSpinner');

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
    }
    if (submitText) submitText.textContent = 'Enviando...';
    if (loadingSpinner) loadingSpinner.classList.remove('hidden');

    try {
      const resultado = await enviarFormularioContacto(datosParaAPI);

      if (resultado.success) {
        mostrarToast('success', '¡Mensaje enviado!', 'Tu solicitud ha sido enviada con éxito.');
        form.reset();

        if (typeof (window as any).gtag !== 'undefined') {
          (window as any).gtag('event', 'form_submit', {
            event_category: 'contact',
            event_label: datosParaAPI.course,
          });
        }
      } else {
        if (
          resultado.message &&
          (resultado.message.includes('RATE_LIMIT_EXCEEDED') ||
            resultado.message.toLowerCase().includes('demasiadas peticiones') ||
            resultado.message.toLowerCase().includes('rate limit'))
        ) {
          mostrarToast(
            'warning',
            '¡Muchos mensajes!',
            'Por favor, espera un momento antes de enviar otro mensaje.'
          );
        } else {
          mostrarToast(
            'error',
            '¡Ha ocurrido un error!',
            resultado.message || 'Por favor, inténtalo de nuevo.'
          );
        }
      }
    } catch (error: any) {
      console.error('Error al enviar formulario:', error);
      mostrarToast(
        'error',
        '¡Error de conexión!',
        'Por favor, verifica tu internet e inténtalo de nuevo.'
      );
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
      if (submitText) submitText.textContent = 'Enviar solicitud';
      if (loadingSpinner) loadingSpinner.classList.add('hidden');
    }
  }

  let enviandoFormulario = false;

  function manejarEnvioConDebounce(event: Event) {
    if (enviandoFormulario) {
      event.preventDefault();
      return;
    }

    enviandoFormulario = true;
    manejarEnvioFormulario(event).finally(() => {
      setTimeout(() => {
        enviandoFormulario = false;
      }, 2000);
    });
  }

  document.addEventListener('DOMContentLoaded', function () {
    const contactForm = document.getElementById('contactForm');
    if (contactForm) {
      contactForm.addEventListener('submit', manejarEnvioConDebounce);

      const inputs = contactForm.querySelectorAll('input, select, textarea');
      inputs.forEach((input) => {
        input.addEventListener('blur', function () {
          const statusMessage = document.getElementById('statusMessage');
          if (statusMessage && !statusMessage.classList.contains('hidden')) {
            statusMessage.style.opacity = '0.5';
          }
        });
      });
    }

    const style = document.createElement('style');
    style.textContent = `
      @keyframes slide-in {
        from {
          transform: translateX(100%);
          opacity: 0;
        }
        to {
          transform: translateX(0);
          opacity: 1;
        }
      }
      
      .animate-slide-in {
        animation: slide-in 0.4s ease-out;
      }
      
      .toast-element {
        transition: opacity 0.3s ease-out, transform 0.3s ease-out;
      }
    `;
    document.head.appendChild(style);
  });
</script>
