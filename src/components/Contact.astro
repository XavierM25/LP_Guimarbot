<section class="flex flex-col justify-between items-center py-40">
  <div class="flex flex-col items-center mb-15">
    <h1 class="font-onest text-[#061B6E] items-center text-[52px] font-extrabold">
      CONTÁCTANOS 📞
    </h1>
    <p class="font-onest text-[#828CB6] text-xl font-medium">
      Solicitar más información sobre inscripción, modalidades y fechas.
    </p>
  </div>

  <div class="w-full flex gap-20 px-10">
    <div class="w-[50%]">
      <form method="post">
        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Apellidos y Nombres</label>
          <input
            type="text"
            placeholder="Apellido y Nombres"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Correo electrónico</label>
          <input
            type="email"
            placeholder="email@email.com"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Teléfono</label>
          <input
            type="tel"
            placeholder="+123456789"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
          />
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold">Curso a seleccionar</label>
          <select
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
          >
            <option value="">Selecciona el curso de interés</option>
            <option value="consulta">Robotics</option>
            <option value="consulta">Coders</option>
            <option value="soporte">Gamers</option>
            <option value="otro">Traders</option>
          </select>
        </div>

        <div class="flex flex-col gap-1 mb-4">
          <label class="text-[#E770E6] text-[17px] font-onest font-bold"
            >¿Cómo podemos ayudarte?</label
          >
          <textarea
            placeholder="Redacta tu mensaje"
            class="p-2.5 border-2 border-[#B0DDFE] bg-white rounded-xl text-[#061B6E] font-normal outline-none placeholder-[#7F8AB2]"
          ></textarea>
        </div>

        <img class="w-full" src="/reCAPTCHA.svg" />

        <button
          type="submit"
          class="w-full flex items-center gap-1 justify-center cursor-pointer font-onest font-bold bg-[#8436D8] text-[#D9E53D] rounded-xl px-3 py-2 mt-4"
          >Enviar solicitud</button
        >
      </form>
    </div>

    <div class="flex w-[40%] justify-around items-center">
      <div class="flex flex-col justify-center items-center">
        <img class="w-40 h-40" src="/images/HeadGuimar.svg" />
        <label
          class="flex font-onest font-semibold italic text-center leading-tight text-[#061B6E] text-[20px]"
          >Únete a la comunidad GuímarBot y<br />construye el futuro desde hoy.</label
        >
      </div>
    </div>
  </div>
</section>
