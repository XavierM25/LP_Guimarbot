---
import { Target } from '@mynaui/icons-react';
import { UsersGroup } from '@mynaui/icons-react';
import { Pencil } from '@mynaui/icons-react';
---

<section id="about" class="flex flex-col justify-between items-center py-30">
  <div class="flex flex-col items-center">
    <h1
      class="font-onest text-[#061B6E] items-center lg:text-[52px] md:text-[36px] text-[28px] font-extrabold"
    >
      NOSOTROS 👥
    </h1>
    <p class="font-onest text-[#828CB6] lg:text-xl md:text-base text-sm text-center font-medium">
      Fundada en 2016, hemos capacitado a más de 1,000 alumnos.
    </p>
  </div>

  <div class="flex lg:gap-28 gap-16 my-15 flex-col lg:flex-row">
    <div class="hover:scale-110 transition-all duration-300">
      <Target className="lg:w-15 lg:h-15 md:w-10 md:h-10 w-8 h-8 text-[#E770E6]" />
      <h2
        class="text-[#061B6E] lg:text-[24px] md:text-[22px] text-[20px] font-onest font-semibold py-2"
      >
        Misión
      </h2>
      <p class="font-onest text-[#7D89B1] lg:text-[16px] text-[14px] leading-tight font-light">
        Brindar acceso a educación tecnológica a niños <br />
        y jóvenes, incluso con recursos limitados, para <br />
        potenciar sus oportunidades futuras.
      </p>
    </div>

    <div class="hover:scale-110 transition-all duration-300">
      <UsersGroup className="lg:w-15 lg:h-15 md:w-10 md:h-10 w-8 h-8 text-[#E770E6]" />
      <h2
        class="text-[#061B6E] lg:text-[24px] md:text-[22px] text-[20px] font-onest font-semibold py-2"
      >
        Comunidad
      </h2>
      <p class="font-onest text-[#7D89B1] lg:text-[16px] text-[14px] leading-tight font-light">
        Un espacio donde niños y jóvenes crecen <br />
        juntos creando tecnología, compartiendo ideas <br />
        y desarrollando habilidades para cambiar el <br />
        mundo desde temprana edad.
      </p>
    </div>

    <div class="hover:scale-110 transition-all duration-300">
      <Pencil className="lg:w-15 lg:h-15 md:w-10 md:h-10 w-8 h-8 text-[#E770E6]" />
      <h2
        class="text-[#061B6E] lg:text-[24px] md:text-[22px] text-[20px] font-onest font-semibold py-2"
      >
        Enfoque diferencial
      </h2>
      <p class="font-onest text-[#7D89B1] lg:text-[16px] text-[14px] leading-tight font-light">
        Fomento de habilidades blandas a través del <br />
        trabajo en equipo y resolución de problemas.
      </p>
    </div>
  </div>
</section>
