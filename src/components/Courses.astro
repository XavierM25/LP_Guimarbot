---
import CardCourse from '@/components/CardCourse.astro';

const courseSections = [
  {
    title: 'PROGRAMACIÓN 💻',
    description:
      'Explora el fascinante mundo del código y el desarrollo digital. Aprende a programar desde cero, crea videojuegos y páginas web usando herramientas modernas y divertidas adaptadas a niños y adolescentes.',
    courses: [
      { title: 'Coders: Fabricando con Código', bgImage: '/images/Curso_Coders.webp' },
      { title: 'Gamers: Programando Diversión', bgImage: '/images/Curso_Gamers.webp' },
    ],
  },
  {
    title: 'ROBÓTICA Y TEC. 🤖',
    description:
      'Desarrolla habilidades STEAM construyendo, programando y diseñando robots. Ideal para despertar la creatividad, la lógica y el pensamiento computacional con herramientas físicas y digitales.',
    courses: [
      { title: 'Robotics: Imaginando y Creando Robots', bgImage: '/images/Curso_Robotics.webp' },
    ],
  },
  {
    title: 'TRADING 💸',
    description:
      'Introducción al mundo de las inversiones, el mercado Forex y las finanzas personales, pensado especialmente para adolescentes que buscan aprender a gestionar su dinero y entender el mercado global.',
    courses: [
      { title: 'Traders: Aprendiendo de Inversiones', bgImage: '/images/Curso_Traders.webp' },
    ],
  },
];
---

<section id="courses">
  <div class="flex items-center lg:mb-7 flex-col">
    <h1
      class="font-onest text-[#061B6E] items-center lg:text-[52px] md:text-[36px] text-[28px] font-extrabold"
    >
      CURSOS 📚
    </h1>
    <p class="font-onest text-[#828CB6] lg:text-xl md:text-base text-sm text-center font-medium">
      En GuímarBot enseñamos tecnología desde la práctica, con proyectos reales que despiertan la
      creatividad, el pensamiento lógico y el trabajo en equipo.
    </p>
  </div>
  <div class="py-11 rounded-[45px]">
    {
      courseSections.map((section) => (
        <div class="space-y-3 mb-24">
          <div class="flex justify-between items-center flex-col xl:flex-row">
            <h2 class="text-[#8436D8] font-black lg:text-[48px] md:text-[36px] text-[24px] font-onest text-center">
              {section.title}
            </h2>
            <p class="text-[#141414] opacity-50 leading-tight lg:text-[16px] md:text-[14px] text-[13px] font-onest font-medium text-center md:text-left xl:w-[50%]">
              {section.description}
            </p>
          </div>
          <div class="w-full h-[2px] bg-[#E770E6]" />
          <div class="grid xl:grid-cols-3 lg:grid-cols-2 grid-cols-1 gap-6 mt-8">
            {section.courses.map((course) => (
              <CardCourse title={course.title} bgImage={course.bgImage} />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
