---
import { ChevronRight } from "@mynaui/icons-react";
---

<section class="my-9">
    <div class="flex items-center justify-between bg-white rounded-4xl px-23 py-17 gap-4">
        <div class="gap-4">
            <h1 class="text-[#061B6E] text-[54px] font-onest font-bold leading-none">
                Formamos creadores digitales con <br> proyectos reales.</h1>
            <p class="whitespace-pre-line font-onest text-[#828CB6] text-xl leading-tight py-7">GuimarBot es una academia peruana especializada en niños y jóvenes,
                con un enfoque en proyectos prácticos y educativos desde temprana edad.</p>
            <button class="flex items-center gap-1 text-[#8436D8] text-lg font-onest font-bold bg-[#D9E53D] rounded-full pl-8 pr-5 pt-2 pb-1.5 cursor-pointer">
                Solicitar Información
                <ChevronRight className="w-6 h-6 text-[#8436D8]" strokeWidth={2}/>
            </button>
        </div>

        <div class="flex w-[25%] justify-center">
            <img src="../public/Logo.svg" alt="Logo">
        </div>
    </div>
</section>