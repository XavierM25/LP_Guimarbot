---
import Icons from '@mynaui/icons-react';
const { ChevronRight } = Icons;
---

<section>
  <div
    class="flex md:flex-row flex-col items-center justify-between bg-white rounded-4xl lg:px-28 lg:py-22 gap-8 p-10 lg:p-0"
  >
    <div class="gap-4 md:w-[70%] w-full">
      <h1
        class="text-[#061B6E] lg:text-[50px] md:text-[30px] text-[20px] font-onest font-bold leading-none"
      >
        Formamos creadores digitales con <br /> proyectos reales.
      </h1>
      <p class="font-onest text-[#828CB6] lg:text-2xl md:text-base text-sm leading-tight pb-8 pt-4">
        GuimarBot es una academia peruana especializada en niños y jóvenes, con un enfoque en
        proyectos prácticos y educativos desde temprana edad.
      </p>
      <a href="#contact">
        <button
          class="mx-auto md:mx-0 group flex items-center gap-1 text-[#8436D8] lg:text-lg text-sm leading-none font-onest font-bold bg-[#D9E53D] rounded-full pl-8 pr-5 py-2.5 cursor-pointer hover:bg-[#8436D8] hover:text-[#D9E53D] transition-all duration-300"
        >
          Solicitar información
          <ChevronRight
            className="lg:w-6 lg:h-6 w-4 h-4 text-[#8436D8] group-hover:text-[#D9E53D] transition-all duration-300"
            strokeWidth={3}
          />
        </button>
      </a>
    </div>

    <div class="flex justify-center">
      <img src="/images/Logo_Hero.webp" class="w-36 h-auto lg:w-44" alt=" Logo" />
    </div>
  </div>
</section>
