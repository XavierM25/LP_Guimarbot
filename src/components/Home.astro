---
import { ChevronRight } from '@mynaui/icons-react';
---

<section>
  <div class="flex items-center justify-between bg-white rounded-4xl px-28 py-22 gap-8">
    <div class="gap-4 w-[70%]">
      <h1 class="text-[#061B6E] text-[50px] font-onest font-bold leading-none">
        Formamos creadores digitales con <br /> proyectos reales.
      </h1>
      <p class="font-onest text-[#828CB6] text-2xl leading-tight pb-8 pt-4">
        GuimarBot es una academia peruana especializada en niños y jóvenes, con un enfoque en
        proyectos prácticos y educativos desde temprana edad.
      </p>
      <button
        class="group flex items-center gap-1 text-[#8436D8] text-lg font-onest font-bold bg-[#D9E53D] rounded-full pl-8 pr-5 py-2.5 cursor-pointer hover:bg-[#8436D8] hover:text-[#D9E53D] transition-all duration-300"
      >
        Solicitar información
        <ChevronRight
          className="w-6 h-6 text-[#8436D8] group-hover:text-[#D9E53D] transition-all duration-300"
          strokeWidth={3}
        />
      </button>
    </div>

    <div class="flex w-[25%] justify-center">
      <img src="/images/Logo_Hero.webp" class="w-auto h-68" alt=" Logo" />
    </div>
  </div>
</section>
